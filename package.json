{
  "name": "eventgate-sl-assets",
  "version": "1.0.0",
  "private": true,
  "description": "Tailwind CSS build assets for EventGate Sierra Leone Django project",
  "scripts": {
    "build:css": "tailwindcss -c ./tailwind.config.js -i ./static/src/input.css -o ./static/css/output.css --minify",
    "watch:css": "tailwindcss -c ./tailwind.config.js -i ./static/src/input.css -o ./static/css/output.css --watch",
    "build:css:dev": "tailwindcss -c ./tailwind.config.js -i ./static/src/input.css -o ./static/css/output.css",
    "clean:css": "node -e \"require('fs').rmSync('./static/css/output.css',{force:true})\""
  },
  "browserslist": [
    "defaults",
    "not IE 11"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.17"
  }
}